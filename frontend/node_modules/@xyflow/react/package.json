{
  "name": "@xyflow/react",
  "version": "13.0.2",
  "description": "React Flow - A highly customizable React library for building node-based editors and interactive flow charts.",
  "keywords": [
    "react",
    "node-based UI",
    "graph",
    "diagram",
    "workflow",
    "react-flow",
    "xyflow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyflow/xyflow.git",
    "directory": "packages/react"
  },
  "homepage": "https://reactflow.dev",
  "bugs": {
    "url": "https://github.com/xyflow/xyflow/issues"
  },
  "files": [
    "dist",
    "src"
  ],
  "source": "src/index.ts",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/base.css": "./dist/base.css",
    "./dist/style.css": "./dist/style.css",
    "./dist/xy-theme.css": "./dist/xy-theme.css",
    "./base.css": "./dist/base.css",
    "./style.css": "./dist/style.css",
    "./xy-theme.css": "./dist/xy-theme.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xyflow/system": "1.0.0",
    "classcat": "^5.0.5",
    "react-compiler-runtime": "^1.0.0",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "@types/react-dom": ">=18",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/eslint": "0.0.1",
    "@xyflow/postcss-config": "0.0.0",
    "@xyflow/tsconfig": "0.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.15.0",
    "postcss": "^8.5.33",
    "postcss-cli": "^12.0.0",
    "prettier": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "dev": "concurrently \"tsdown --watch\" \"pnpm:css-watch\"",
    "build": "pnpm run css && tsdown",
    "css": "postcss src/styles/{base,style,xy-theme}.css --dir dist ",
    "css-watch": "pnpm css --watch",
    "format": "prettier --write .",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  }
}